# Dati personali: non devono mai finire nel repository.
profilo.json
giornaliero.log

# Cache locali: si rigenerano, e .llm_cache contiene le risposte del modello
# (non sono segrete, ma pesano e cambiano a ogni ciclo).
.data_cache/
.llm_cache/

# Stato delle notifiche e schermate di sviluppo
.opportunita_viste.json
.shots/

# La dashboard privata: contiene il profilo se c'e'. Si pubblica "sito/".
web/data.js

# La copia pubblica generata dal PC, per il caricamento a mano di emergenza.
# Fuori dal repository di proposito: "sito/" la scrive il ciclo nel cloud, e
# deve avere un solo autore (vedi il commento in giornaliero.cmd).
da-caricare/

# Python
__pycache__/
*.pyc
